<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0</TargetFrameworks>
    <!-- On Windows, also run the suite on .NET Framework, which exercises the library's netstandard2.0 build
         and the older HttpClient stack (the one most likely to re-format signed headers). -->
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('Windows'))">net10.0;net48</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <RootNamespace>SolisCloud.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- Test code is not a public API, so XML documentation is not required. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!--
    .NET Framework: System.Net.Http is a separate assembly that SDK-style projects don't reference by default, and
    the SDK leaves it out of the implicit usings for that reason.
    Microsoft.Extensions.TimeProvider.Testing ships a net462 build but warns that .NET Framework is untested. It is a
    test-only dependency and the tests exercise it, so the warning is acknowledged here rather than ignored globally.
  -->
  <PropertyGroup Condition="$([MSBuild]::GetTargetFrameworkIdentifier('$(TargetFramework)')) == '.NETFramework'">
    <SuppressTfmSupportBuildWarnings>true</SuppressTfmSupportBuildWarnings>
  </PropertyGroup>

  <ItemGroup Condition="$([MSBuild]::GetTargetFrameworkIdentifier('$(TargetFramework)')) == '.NETFramework'">
    <Reference Include="System.Net.Http" />
    <Using Include="System.Net.Http" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\SolisCloud.Client\SolisCloud.Client.csproj" />
  </ItemGroup>

</Project>
