<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    Only nuget.org, and every package must map to it. This blocks "dependency confusion":
    a machine-level feed can never silently supply a package with the same name.
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
