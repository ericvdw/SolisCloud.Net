<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net10.0</TargetFrameworks>
    <RootNamespace>SolisCloud</RootNamespace>
    <PackageId>SolisCloud.Client</PackageId>
    <Description>Unofficial, strongly typed client for the SolisCloud platform API: request signing, rate limiting and normalised models.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IsPackable>true</IsPackable>
    <!-- Checks that the netstandard2.0 and net10.0 builds expose a compatible API when packing. -->
    <EnablePackageValidation>true</EnablePackageValidation>
  </PropertyGroup>

  <!-- Modern .NET only: flag any code that would break under trimming or Native AOT. -->
  <PropertyGroup Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net8.0'))">
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)..\..\README.md" Pack="true" PackagePath="\" Visible="false" />
    <InternalsVisibleTo Include="SolisCloud.Client.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Tracks the public API surface in PublicAPI.*.txt; any change shows up in code review. -->
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
    <AdditionalFiles Include="PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI.Unshipped.txt" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" />
    <PackageReference Include="Microsoft.Bcl.TimeProvider" />
    <PackageReference Include="System.Text.Json" />
    <!-- Source generator: compiler-support attributes (init, required, nullable attributes...) for older targets. -->
    <PackageReference Include="PolySharp" PrivateAssets="all" />
  </ItemGroup>

</Project>
