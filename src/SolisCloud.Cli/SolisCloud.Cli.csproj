<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>SolisCloud.Cli</RootNamespace>
    <Description>Command-line tool for the SolisCloud platform API: check credentials, call any operation, and capture sanitised responses.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>

    <!-- Distributed as a .NET tool: dotnet tool install -g SolisCloud.Cli, then run `solis`. -->
    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>solis</ToolCommandName>
    <PackageId>SolisCloud.Cli</PackageId>

    <!-- Output is culture-independent (JSON and invariant numbers), so the ICU data isn't needed. -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Keeps the tool trim- and AOT-safe, which also keeps it honest about reflection. -->
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)..\..\README.md" Pack="true" PackagePath="\" Visible="false" />
    <InternalsVisibleTo Include="SolisCloud.Cli.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SolisCloud.Client\SolisCloud.Client.csproj" />
  </ItemGroup>

</Project>
